# BDays settings. Copy to .env and fill in; .env is git-ignored.
# Paths are relative to this folder unless absolute.

# --- web server ---
HOST=127.0.0.1
PORT=5000
# Never enable on an instance reachable through the gateway/Funnel:
# the Werkzeug debugger can execute code.
FLASK_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- storage ---
DATA_DIR=data
# family -> Google calendar mapping (edited from /settings); see config.example.json
CONFIG_FILE=config.json

# --- Google Calendar ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Open a browser for OAuth consent when the token is missing/expired.
GOOGLE_ALLOW_BROWSER_AUTH=true
CALENDAR_TIMEZONE=Asia/Jerusalem
# Years written when pushing recurring events.
CALENDAR_FIRST_YEAR=2000
CALENDAR_LAST_YEAR=2100
