# -------------------------------------------------------
# BDays .gitignore
# -------------------------------------------------------

# --- Runtime data (real family entries – do NOT commit) ---
data/*.json
!data/*.sample.json

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Flask session / debug ---
instance/
.flask_session/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
birthday_system.log

# --- Secrets & personal config (never commit; templates are tracked) ---
.env
credentials.json
token.json
config.json

# --- Deprecated files, kept locally until removed ---
*.depr

# atomic-write temp files
*.tmp

# --- Personal data in any data subfolder (only *.sample.json is tracked) ---
data/**/*.json
!data/*.sample.json
